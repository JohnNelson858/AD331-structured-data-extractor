# Copy to .env on your own computer. Never commit actual credentials.
OPENAI_API_KEY=
# Strict request shape is tested offline; live account access remains unverified.
OPENAI_MODEL=gpt-4o-mini
DLQ_DIR=runtime/dlq

# Optional file-based key, used by the opt-in Docker secrets override.
# When nonempty, the file takes precedence over OPENAI_API_KEY.
OPENAI_API_KEY_FILE=
